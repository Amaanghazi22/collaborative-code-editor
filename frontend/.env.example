# ── Local development ─────────────────────────────────────────────────────────
VITE_COLLAB_CODE_BACKEND_URL=http://localhost:5001/
VITE_COLLAB_CODE_SOCKET_URL=http://localhost:5001/

# ── Production (Render + Vercel) ──────────────────────────────────────────────
# VITE_COLLAB_CODE_BACKEND_URL=https://collab-editor-backend.onrender.com/
# VITE_COLLAB_CODE_SOCKET_URL=https://collab-editor-backend.onrender.com/

# ── Code execution via Judge0 ─────────────────────────────────────────────────
# Self-hosted locally (Mac Intel only — does not work on Apple Silicon):
#   cd ~/judge0-local && docker-compose up -d
# VITE_JUDGE0_URL=http://localhost:2358

# Self-hosted on Render (set to your Judge0 Render service URL):
# VITE_JUDGE0_URL=https://collab-editor-judge0.onrender.com

# Via RapidAPI (free tier, requires card on file):
# VITE_JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# VITE_JUDGE0_API_KEY=your_rapidapi_key_here
